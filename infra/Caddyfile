{$HYP_DOMAIN} {
  encode zstd gzip

  @backend path /api /api/* /health /health/*
  handle @backend {
    reverse_proxy api:3000
  }

  # Missing hashed assets must return 404 instead of an HTML application shell.
  handle /assets/* {
    root * /srv
    file_server
  }

  handle {
    root * /srv
    route {
      try_files {path} /index.html
      header /index.html Cache-Control "public, max-age=0, must-revalidate"
      file_server
    }
  }
}
