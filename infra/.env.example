HYP_DOMAIN=inventory.example.com
HYP_API_IMAGE=huoyoupu-api:local
HYP_WEB_IMAGE=huoyoupu-web:local
# Release deployment must replace these major tags with approved immutable digests.
HYP_PG_IMAGE=postgres:18-bookworm
# Caddy is the base of the built web image; select its digest with --build-arg CADDY_IMAGE.
HYP_ADMIN_LOGIN=admin

HYP_DB_NAME=huoyoupu

# Optional AI; keep actual keys in private .env / secret management, never git.
AI_API_KEY=
AI_MODEL=
AI_ENDPOINT=https://api.openai.com/v1/responses
